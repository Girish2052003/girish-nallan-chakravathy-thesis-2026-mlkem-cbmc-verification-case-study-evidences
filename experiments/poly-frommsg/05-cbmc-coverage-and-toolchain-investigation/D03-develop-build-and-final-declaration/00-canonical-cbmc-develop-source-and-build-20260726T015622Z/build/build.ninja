# Utility command for test

build src/cpp/CMakeFiles/test.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/src/cpp && /usr/bin/ctest --force-new-ctest-process
  DESC = Running tests...
  pool = console
  restat = 1

build src/cpp/test: phony src/cpp/CMakeFiles/test.util


#############################################
# Utility command for edit_cache

build src/cpp/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/src/cpp && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build src/cpp/edit_cache: phony src/cpp/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build src/cpp/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/src/cpp && /usr/bin/cmake --regenerate-during-build -S/workspace/source -B/workspace/build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build src/cpp/rebuild_cache: phony src/cpp/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build src/cpp/list_install_components: phony


#############################################
# Utility command for install

build src/cpp/CMakeFiles/install.util: CUSTOM_COMMAND src/cpp/all
  COMMAND = cd /workspace/build/src/cpp && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build src/cpp/install: phony src/cpp/CMakeFiles/install.util


#############################################
# Utility command for install/local

build src/cpp/CMakeFiles/install/local.util: CUSTOM_COMMAND src/cpp/all
  COMMAND = cd /workspace/build/src/cpp && /usr/bin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build src/cpp/install/local: phony src/cpp/CMakeFiles/install/local.util


