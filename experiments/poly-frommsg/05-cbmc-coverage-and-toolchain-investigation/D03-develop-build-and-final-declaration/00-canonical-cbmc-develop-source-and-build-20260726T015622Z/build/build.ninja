build bin/memory-analyzer: CXX_EXECUTABLE_LINKER__memory-analyzer_Release src/memory-analyzer/CMakeFiles/memory-analyzer.dir/memory_analyzer_main.cpp.o | lib/libmemory-analyzer-lib.a lib/libansi-c.a lib/libgoto-programs.a lib/libanalyses.a lib/liblinking.a lib/libpointer-analysis.a lib/libansi-c.a lib/libgoto-programs.a lib/libanalyses.a lib/liblinking.a lib/libpointer-analysis.a lib/libassembler.a lib/libsolvers.a lib/libminisat2-condensed.a lib/libutil.a lib/liblangapi.a lib/libutil.a lib/liblangapi.a lib/libbig-int.a || lib/libanalyses.a lib/libassembler.a lib/libbig-int.a lib/liblangapi.a lib/libmemory-analyzer-lib.a lib/libminisat2-condensed.a lib/libsolvers.a
  FLAGS = -Wall -Wpedantic -Werror -Wswitch-enum          -Wno-deprecated-declarations -Wno-maybe-uninitialized -O2
  LINK_LIBRARIES = lib/libmemory-analyzer-lib.a  lib/libansi-c.a  lib/libgoto-programs.a  lib/libanalyses.a  lib/liblinking.a  lib/libpointer-analysis.a  lib/libansi-c.a  lib/libgoto-programs.a  lib/libanalyses.a  lib/liblinking.a  lib/libpointer-analysis.a  lib/libassembler.a  lib/libsolvers.a  lib/libminisat2-condensed.a  lib/libutil.a  lib/liblangapi.a  lib/libutil.a  lib/liblangapi.a  lib/libbig-int.a
  OBJECT_DIR = src/memory-analyzer/CMakeFiles/memory-analyzer.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_COMPILE_PDB = src/memory-analyzer/CMakeFiles/memory-analyzer.dir/
  TARGET_FILE = bin/memory-analyzer
  TARGET_PDB = bin/memory-analyzer.pdb


