# =============================================================================
# Object build statements for EXECUTABLE target driver


#############################################
# Order-only phony target for driver

build cmake_object_order_depends_target_driver: phony || cmake_object_order_depends_target_big-int cmake_object_order_depends_target_langapi

build regression/invariants/CMakeFiles/driver.dir/driver.cpp.o: CXX_COMPILER__driver_unscanned_Release /workspace/source/regression/invariants/driver.cpp || cmake_object_order_depends_target_driver
  DEP_FILE = regression/invariants/CMakeFiles/driver.dir/driver.cpp.o.d
  FLAGS = -Wall -Wpedantic -Werror -Wswitch-enum          -Wno-deprecated-declarations -Wno-maybe-uninitialized -O2 -std=c++17
  INCLUDES = -I/workspace/build/src -I/workspace/source/src -I/workspace/build/src/big-int -I/workspace/source/src/big-int -I/workspace/build/src/util -I/workspace/source/src/util -I/workspace/build/src/langapi -I/workspace/source/src/langapi
  OBJECT_DIR = regression/invariants/CMakeFiles/driver.dir
  OBJECT_FILE_DIR = regression/invariants/CMakeFiles/driver.dir
  TARGET_COMPILE_PDB = regression/invariants/CMakeFiles/driver.dir/
  TARGET_PDB = bin/driver.pdb


# =============================================================================
# Link build statements for EXECUTABLE target driver


#############################################
# Link the executable bin/driver

build bin/driver: CXX_EXECUTABLE_LINKER__driver_Release regression/invariants/CMakeFiles/driver.dir/driver.cpp.o | lib/libbig-int.a lib/libutil.a lib/liblangapi.a lib/libutil.a lib/liblangapi.a lib/libbig-int.a || lib/libbig-int.a lib/liblangapi.a
  FLAGS = -Wall -Wpedantic -Werror -Wswitch-enum          -Wno-deprecated-declarations -Wno-maybe-uninitialized -O2
  LINK_LIBRARIES = lib/libbig-int.a  lib/libutil.a  lib/liblangapi.a  lib/libutil.a  lib/liblangapi.a  lib/libbig-int.a
  OBJECT_DIR = regression/invariants/CMakeFiles/driver.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_COMPILE_PDB = regression/invariants/CMakeFiles/driver.dir/
  TARGET_FILE = bin/driver
  TARGET_PDB = bin/driver.pdb


