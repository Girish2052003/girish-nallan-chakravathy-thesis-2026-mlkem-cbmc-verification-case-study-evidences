#############################################
# Utility command for package

build unit/CMakeFiles/package.util: CUSTOM_COMMAND unit/all
  COMMAND = cd /workspace/build && /usr/bin/cpack --config ./CPackConfig.cmake
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

build unit/package: phony unit/CMakeFiles/package.util


#############################################
# Utility command for package_source

build unit/CMakeFiles/package_source.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build && /usr/bin/cpack --config ./CPackSourceConfig.cmake /workspace/build/CPackSourceConfig.cmake
  DESC = Run CPack packaging tool for source...
  pool = console
  restat = 1

build unit/package_source: phony unit/CMakeFiles/package_source.util


#############################################
# Utility command for test

build unit/CMakeFiles/test.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/unit && /usr/bin/ctest --force-new-ctest-process
  DESC = Running tests...
  pool = console
  restat = 1

build unit/test: phony unit/CMakeFiles/test.util


#############################################
# Utility command for edit_cache

build unit/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/unit && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build unit/edit_cache: phony unit/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build unit/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/unit && /usr/bin/cmake --regenerate-during-build -S/workspace/source -B/workspace/build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build unit/rebuild_cache: phony unit/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build unit/list_install_components: phony


#############################################
# Utility command for install

build unit/CMakeFiles/install.util: CUSTOM_COMMAND unit/all
  COMMAND = cd /workspace/build/unit && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build unit/install: phony unit/CMakeFiles/install.util


#############################################
# Utility command for install/local

build unit/CMakeFiles/install/local.util: CUSTOM_COMMAND unit/all
  COMMAND = cd /workspace/build/unit && /usr/bin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build unit/install/local: phony unit/CMakeFiles/install/local.util


#############################################
# Utility command for install/strip

build unit/CMakeFiles/install/strip.util: CUSTOM_COMMAND unit/all
  COMMAND = cd /workspace/build/unit && /usr/bin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build unit/install/strip: phony unit/CMakeFiles/install/strip.util


