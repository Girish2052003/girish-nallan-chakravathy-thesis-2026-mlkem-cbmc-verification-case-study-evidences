#############################################
# Utility command for package

build minisat2-build/CMakeFiles/package.util: CUSTOM_COMMAND minisat2-build/all
  COMMAND = cd /workspace/build && /usr/bin/cpack --config ./CPackConfig.cmake
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

build minisat2-build/package: phony minisat2-build/CMakeFiles/package.util


#############################################
# Utility command for package_source

build minisat2-build/CMakeFiles/package_source.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build && /usr/bin/cpack --config ./CPackSourceConfig.cmake /workspace/build/CPackSourceConfig.cmake
  DESC = Run CPack packaging tool for source...
  pool = console
  restat = 1

build minisat2-build/package_source: phony minisat2-build/CMakeFiles/package_source.util


#############################################
# Utility command for test

build minisat2-build/CMakeFiles/test.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/minisat2-build && /usr/bin/ctest --force-new-ctest-process
  DESC = Running tests...
  pool = console
  restat = 1

build minisat2-build/test: phony minisat2-build/CMakeFiles/test.util


#############################################
# Utility command for edit_cache

build minisat2-build/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/minisat2-build && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build minisat2-build/edit_cache: phony minisat2-build/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build minisat2-build/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/minisat2-build && /usr/bin/cmake --regenerate-during-build -S/workspace/source -B/workspace/build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build minisat2-build/rebuild_cache: phony minisat2-build/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build minisat2-build/list_install_components: phony


#############################################
# Utility command for install

build minisat2-build/CMakeFiles/install.util: CUSTOM_COMMAND minisat2-build/all
  COMMAND = cd /workspace/build/minisat2-build && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build minisat2-build/install: phony minisat2-build/CMakeFiles/install.util


#############################################
# Utility command for install/local

build minisat2-build/CMakeFiles/install/local.util: CUSTOM_COMMAND minisat2-build/all
  COMMAND = cd /workspace/build/minisat2-build && /usr/bin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build minisat2-build/install/local: phony minisat2-build/CMakeFiles/install/local.util


#############################################
# Utility command for install/strip

build minisat2-build/CMakeFiles/install/strip.util: CUSTOM_COMMAND minisat2-build/all
