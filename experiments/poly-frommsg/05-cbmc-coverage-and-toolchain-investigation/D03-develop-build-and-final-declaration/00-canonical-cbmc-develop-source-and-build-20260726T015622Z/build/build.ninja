#############################################
# Utility command for package

build src/linking/CMakeFiles/package.util: CUSTOM_COMMAND src/linking/all
  COMMAND = cd /workspace/build && /usr/bin/cpack --config ./CPackConfig.cmake
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

build src/linking/package: phony src/linking/CMakeFiles/package.util


#############################################
# Utility command for package_source

build src/linking/CMakeFiles/package_source.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build && /usr/bin/cpack --config ./CPackSourceConfig.cmake /workspace/build/CPackSourceConfig.cmake
  DESC = Run CPack packaging tool for source...
  pool = console
  restat = 1

build src/linking/package_source: phony src/linking/CMakeFiles/package_source.util


#############################################
# Utility command for test

build src/linking/CMakeFiles/test.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/src/linking && /usr/bin/ctest --force-new-ctest-process
  DESC = Running tests...
  pool = console
  restat = 1

build src/linking/test: phony src/linking/CMakeFiles/test.util


#############################################
# Utility command for edit_cache

build src/linking/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/src/linking && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build src/linking/edit_cache: phony src/linking/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build src/linking/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/src/linking && /usr/bin/cmake --regenerate-during-build -S/workspace/source -B/workspace/build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build src/linking/rebuild_cache: phony src/linking/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build src/linking/list_install_components: phony


#############################################
# Utility command for install

build src/linking/CMakeFiles/install.util: CUSTOM_COMMAND src/linking/all
  COMMAND = cd /workspace/build/src/linking && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build src/linking/install: phony src/linking/CMakeFiles/install.util


#############################################
# Utility command for install/local

build src/linking/CMakeFiles/install/local.util: CUSTOM_COMMAND src/linking/all
  COMMAND = cd /workspace/build/src/linking && /usr/bin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build src/linking/install/local: phony src/linking/CMakeFiles/install/local.util


#############################################
# Utility command for install/strip

build src/linking/CMakeFiles/install/strip.util: CUSTOM_COMMAND src/linking/all
  COMMAND = cd /workspace/build/src/linking && /usr/bin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build src/linking/install/strip: phony src/linking/CMakeFiles/install/strip.util

