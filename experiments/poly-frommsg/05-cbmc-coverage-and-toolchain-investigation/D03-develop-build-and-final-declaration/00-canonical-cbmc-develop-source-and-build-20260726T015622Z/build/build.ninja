# Utility command for list_install_components

build src/ansi-c/list_install_components: phony


#############################################
# Utility command for install

build src/ansi-c/CMakeFiles/install.util: CUSTOM_COMMAND src/ansi-c/all
  COMMAND = cd /workspace/build/src/ansi-c && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build src/ansi-c/install: phony src/ansi-c/CMakeFiles/install.util


