build src/cpp/CMakeFiles/install/strip.util: CUSTOM_COMMAND src/cpp/all
  COMMAND = cd /workspace/build/src/cpp && /usr/bin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
  DESC = Installing the project stripped...
