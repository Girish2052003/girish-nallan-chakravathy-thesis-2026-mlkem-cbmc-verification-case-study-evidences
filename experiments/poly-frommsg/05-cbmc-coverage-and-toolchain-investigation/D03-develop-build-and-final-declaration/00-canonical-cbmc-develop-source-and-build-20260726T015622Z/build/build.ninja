#############################################
# Utility command for package

build src/ansi-c/CMakeFiles/package.util: CUSTOM_COMMAND src/ansi-c/all
  COMMAND = cd /workspace/build && /usr/bin/cpack --config ./CPackConfig.cmake
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

build src/ansi-c/package: phony src/ansi-c/CMakeFiles/package.util


#############################################
# Utility command for package_source

build src/ansi-c/CMakeFiles/package_source.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build && /usr/bin/cpack --config ./CPackSourceConfig.cmake /workspace/build/CPackSourceConfig.cmake
  DESC = Run CPack packaging tool for source...
  pool = console
  restat = 1

build src/ansi-c/package_source: phony src/ansi-c/CMakeFiles/package_source.util


#############################################
# Utility command for test

build src/ansi-c/CMakeFiles/test.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/src/ansi-c && /usr/bin/ctest --force-new-ctest-process
  DESC = Running tests...
  pool = console
  restat = 1

build src/ansi-c/test: phony src/ansi-c/CMakeFiles/test.util


#############################################
# Utility command for edit_cache

build src/ansi-c/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/src/ansi-c && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build src/ansi-c/edit_cache: phony src/ansi-c/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build src/ansi-c/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/src/ansi-c && /usr/bin/cmake --regenerate-during-build -S/workspace/source -B/workspace/build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build src/ansi-c/rebuild_cache: phony src/ansi-c/CMakeFiles/rebuild_cache.util


