  COMMAND = cd /workspace/build/src/crangler && /usr/bin/cmake --regenerate-during-build -S/workspace/source -B/workspace/build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build src/crangler/rebuild_cache: phony src/crangler/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build src/crangler/list_install_components: phony


#############################################
# Utility command for install

build src/crangler/CMakeFiles/install.util: CUSTOM_COMMAND src/crangler/all
  COMMAND = cd /workspace/build/src/crangler && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build src/crangler/install: phony src/crangler/CMakeFiles/install.util


#############################################
# Utility command for install/local

build src/crangler/CMakeFiles/install/local.util: CUSTOM_COMMAND src/crangler/all
  COMMAND = cd /workspace/build/src/crangler && /usr/bin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build src/crangler/install/local: phony src/crangler/CMakeFiles/install/local.util


#############################################
# Utility command for install/strip

build src/crangler/CMakeFiles/install/strip.util: CUSTOM_COMMAND src/crangler/all
  COMMAND = cd /workspace/build/src/crangler && /usr/bin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build src/crangler/install/strip: phony src/crangler/CMakeFiles/install/strip.util


#############################################
# Custom command for src/crangler/c_lex.yy.cpp

build src/crangler/c_lex.yy.cpp | ${cmake_ninja_workdir}src/crangler/c_lex.yy.cpp: CUSTOM_COMMAND /workspace/source/src/crangler/scanner.l || lib/libbig-int.a lib/libjson.a lib/liblangapi.a lib/libutil.a src/util/generate_version_cpp
  COMMAND = cd /workspace/source/src/crangler && /usr/bin/flex -Pyyc -o/workspace/build/src/crangler/c_lex.yy.cpp /workspace/source/src/crangler/scanner.l
  DESC = [FLEX][scanner] Building scanner with flex 2.6.4
  restat = 1

