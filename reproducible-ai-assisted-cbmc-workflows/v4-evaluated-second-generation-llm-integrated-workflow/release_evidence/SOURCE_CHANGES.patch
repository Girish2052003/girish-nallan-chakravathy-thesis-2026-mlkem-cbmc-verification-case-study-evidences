+def classify_stage_presence(run_dir: Path, stage_key: str, *, manifest_exists: bool, stage_dir_exists: bool) -> str:
+    """Classify absent stages without treating policy-controlled absence as corruption."""
+    if manifest_exists:
+        return "completed"
+    status_path = run_dir / "status.json"
+    resolved_path = run_dir / "run_config.resolved.json"
+    status, _ = try_load_json(status_path) if status_path.exists() else ({}, None)
+    resolved, _ = try_load_json(resolved_path) if resolved_path.exists() else ({}, None)
+    status = status if isinstance(status, dict) else {}
+    resolved = resolved if isinstance(resolved, dict) else {}
+    stopped_reason = str(status.get("stopped_reason") or "")
+    provisional = str(status.get("provisional_final_status") or status.get("status") or "")
+    max_iterations = int(resolved.get("max_iterations", 0) or 0)
+
+    if stage_key == "10_experiment_logger":
+        return "in_progress"
+    if stage_key == "11_evaluation_reporter":
+        return "not_yet_run"
+    if stage_key == "09_repair_refinement" and max_iterations == 0:
+        return "not_applicable"
+    if stage_key == "07_tool_execution" and (
+        "critic_requested" in stopped_reason or "blocked_" in stopped_reason
+    ):
+        return "blocked_upstream"
+    if stage_key == "08_counterexample_analysis" and not stage_manifest_path(run_dir, "07_tool_execution").exists():
+        return "blocked_upstream"
+    if stage_key == "09_repair_refinement" and (
+        "passed_selected_properties" in provisional or "analysis_only" in stopped_reason
+    ):
+        return "not_applicable"
+    if stage_key in {"08_counterexample_analysis", "09_repair_refinement"} and "iteration_limit" in stopped_reason:
+        return "skipped_by_policy"
+    if stage_dir_exists:
+        return "failed_to_write"
+    return "unexpectedly_missing"
