{
  "profile_schema_version": "thesis_llm_profile.v1",
  "provider": "openai",
  "mode": "real",
  "model": "gpt-5.4-mini",
  "api_key_env": "OPENAI_API_KEY",
  "reasoning": {
    "effort": "xhigh"
  },
  "text": {
    "verbosity": "high"
  },
  "max_output_tokens": 32000,
  "preflight_max_output_tokens": 256,
  "store": false,
  "max_retries": 2,
  "retry_sleep_seconds": 2.0
}
