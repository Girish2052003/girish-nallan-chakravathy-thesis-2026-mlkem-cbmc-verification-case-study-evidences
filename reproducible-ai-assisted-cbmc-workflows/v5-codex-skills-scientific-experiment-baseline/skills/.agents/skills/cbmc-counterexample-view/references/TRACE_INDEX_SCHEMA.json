{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "analysis_nature": {
      "const": "MECHANICAL_TRACE_NORMALIZATION_ONLY"
    },
    "schema_version": {
      "const": "1.0"
    },
    "semantic_authority": {
      "const": "NONE"
    },
    "step_count": {
      "minimum": 0,
      "type": "integer"
    },
    "steps": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "assignment_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "called_function": {
            "type": [
              "string",
              "null"
            ]
          },
          "condition": {
            "type": [
              "string",
              "null"
            ]
          },
          "function": {
            "type": [
              "string",
              "null"
            ]
          },
          "hidden": {
            "type": "boolean"
          },
          "lhs": {
            "type": [
              "string",
              "null"
            ]
          },
          "original_index": {
            "minimum": 0,
            "type": "integer"
          },
          "property_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "raw_step": {},
          "source_location": {
            "additionalProperties": false,
            "properties": {
              "column": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "function": {
                "type": "string"
              },
              "line": {
                "type": "string"
              },
              "workingDirectory": {
                "type": "string"
              }
            },
            "type": [
              "object",
              "null"
            ]
          },
          "step_type": {
            "type": "string"
          },
          "thread": {
            "type": [
              "string",
              "null"
            ]
          },
          "value": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "original_index",
          "step_type",
          "hidden",
          "source_location",
          "function",
          "called_function",
          "thread",
          "lhs",
          "value",
          "condition",
          "property_id",
          "assignment_type",
          "raw_step"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "analysis_nature",
    "semantic_authority",
    "step_count",
    "steps"
  ],
  "title": "Normalized CBMC Trace Index",
  "type": "object"
}
