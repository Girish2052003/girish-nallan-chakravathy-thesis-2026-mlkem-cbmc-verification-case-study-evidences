{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "analysis_nature": {
      "const": "MECHANICAL_BOUNDED_TRACE_PRESENTATION_ONLY"
    },
    "endpoint_step": {
      "type": [
        "object",
        "null"
      ]
    },
    "function_call_return_sequence": {
      "type": "array"
    },
    "latest_observed_assignments": {
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "1.0"
    },
    "selected_steps": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "assignment_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "called_function": {
            "type": [
              "string",
              "null"
            ]
          },
          "condition": {
            "type": [
              "string",
              "null"
            ]
          },
          "function": {
            "type": [
              "string",
              "null"
            ]
          },
          "hidden": {
            "type": "boolean"
          },
          "lhs": {
            "type": [
              "string",
              "null"
            ]
          },
          "original_index": {
            "minimum": 0,
            "type": "integer"
          },
          "property_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "raw_step": {},
          "selected_index": {
            "minimum": 0,
            "type": "integer"
          },
          "selection_reasons": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "source_location": {
            "additionalProperties": false,
            "properties": {
              "column": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "function": {
                "type": "string"
              },
              "line": {
                "type": "string"
              },
              "workingDirectory": {
                "type": "string"
              }
            },
            "type": [
              "object",
              "null"
            ]
          },
          "step_type": {
            "type": "string"
          },
          "thread": {
            "type": [
              "string",
              "null"
            ]
          },
          "value": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "original_index",
          "step_type",
          "hidden",
          "source_location",
          "function",
          "called_function",
          "thread",
          "lhs",
          "value",
          "condition",
          "property_id",
          "assignment_type",
          "raw_step",
          "selected_index",
          "selection_reasons"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "selection": {
      "type": "object"
    },
    "semantic_authority": {
      "const": "NONE"
    }
  },
  "required": [
    "schema_version",
    "analysis_nature",
    "semantic_authority",
    "selection",
    "selected_steps",
    "function_call_return_sequence",
    "latest_observed_assignments",
    "endpoint_step",
    "limitations"
  ],
  "title": "Compact Counterexample Trace",
  "type": "object"
}
