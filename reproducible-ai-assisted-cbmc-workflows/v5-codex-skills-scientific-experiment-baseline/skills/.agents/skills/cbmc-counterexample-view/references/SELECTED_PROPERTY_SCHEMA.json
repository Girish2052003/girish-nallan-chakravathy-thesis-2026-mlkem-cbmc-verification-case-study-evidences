{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "property_id": {
      "type": "string"
    },
    "raw_trace_step_count": {
      "minimum": 0,
      "type": "integer"
    },
    "recorded_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "const": "1.0"
    },
    "source_location": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "function": {
          "type": "string"
        },
        "line": {
          "type": "string"
        },
        "workingDirectory": {
          "type": "string"
        }
      },
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "property_id",
    "recorded_status",
    "description",
    "source_location",
    "raw_trace_step_count"
  ],
  "title": "Selected CBMC Property",
  "type": "object"
}
