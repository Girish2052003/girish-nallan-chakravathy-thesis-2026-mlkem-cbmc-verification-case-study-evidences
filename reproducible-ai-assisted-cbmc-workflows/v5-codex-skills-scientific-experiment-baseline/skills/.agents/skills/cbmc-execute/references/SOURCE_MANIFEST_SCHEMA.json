{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/v5/cbmc-execute/source-manifest-schema.json",
  "title": "cbmc-execute source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "phase", "workspace_root_sha256_disclosure", "files"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "phase": {"enum": ["BEFORE", "AFTER"]},
    "workspace_root_sha256_disclosure": {"const": "PATH_NOT_HASHED"},
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "size_bytes", "sha256", "expected_sha256", "expected_match"],
        "properties": {
          "path": {"type": "string"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "expected_sha256": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]},
          "expected_match": {"anyOf": [{"type": "boolean"}, {"type": "null"}]}
        }
      }
    }
  }
}
