{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/v5/cbmc-execute/input-schema.json",
  "title": "cbmc-execute request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "working_directory", "analysis_sources", "tracked_inputs", "analysis"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "request_id": {"type": "string", "minLength": 1},
    "working_directory": {"type": "string", "minLength": 1},
    "analysis_sources": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "tracked_inputs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "expected_sha256": {
      "type": "object",
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "analysis": {
      "type": "object", "additionalProperties": false, "required": ["options"],
      "properties": {
        "options": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
      }
    },
    "inventory": {
      "type": "object", "additionalProperties": false, "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "options": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
      }
    },
    "execution_environment": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Z_][A-Z0-9_]*$"},
      "additionalProperties": {"type": "string"}
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "memory_mb": {"type": "integer", "minimum": 64, "maximum": 1048576},
        "file_size_mb": {"type": "integer", "minimum": 1, "maximum": 4096}
      }
    },
    "clock": {
      "type": "object", "additionalProperties": false, "required": ["mode"],
      "properties": {"mode": {"enum": ["wall_clock", "source_date_epoch"]}}
    },
    "notes": {"type": "string"}
  }
}
