{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/v5/cbmc-harness-scaffold/input.schema.json",
  "title": "CBMC Harness Scaffold Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "target", "harness", "source_bindings"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "request_id": {"type": "string", "minLength": 1},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "source_file", "arguments"],
      "properties": {
        "symbol": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "source_file": {"type": "string", "minLength": 1},
        "arguments": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1}},
        "return_capture": {
          "oneOf": [
            {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {"mode": {"const": "none"}}},
            {"type": "object", "additionalProperties": false, "required": ["mode", "variable"], "properties": {"mode": {"const": "assign"}, "variable": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}}}
          ]
        }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "entry_function", "language_standard", "includes", "declarations"],
      "properties": {
        "filename": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+\\.c$"},
        "entry_function": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "language_standard": {"enum": ["c90", "c99", "c11", "gnu90", "gnu99", "gnu11"]},
        "includes": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["style", "value"],
            "properties": {"style": {"enum": ["quoted", "system"]}, "value": {"type": "string", "minLength": 1}}
          }
        },
        "declarations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "name"],
            "properties": {
              "type": {"type": "string", "minLength": 1},
              "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
              "array_dimensions": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1}},
              "role": {"enum": ["input", "output", "inout", "auxiliary", "return"]}
            }
          }
        }
      }
    },
    "source_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "expected_sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "expected_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "compile_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "required": {"type": "boolean"},
        "compiler": {"enum": ["gcc", "clang", "cc"]},
        "include_dirs": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1}},
        "defines": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {"name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}, "value": {"type": ["string", "null"]}}
          }
        },
        "extra_args": {"type": "array", "maxItems": 32, "items": {"type": "string"}},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300}
      }
    }
  }
}
