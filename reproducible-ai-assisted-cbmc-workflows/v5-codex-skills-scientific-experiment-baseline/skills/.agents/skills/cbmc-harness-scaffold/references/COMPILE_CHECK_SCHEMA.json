{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Scaffold Compile Check Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["enabled", "required", "status", "argv", "exit_code", "timed_out", "stdout_sha256", "stderr_sha256", "stdout_size_bytes", "stderr_size_bytes"],
  "properties": {
    "enabled": {"const": true},
    "required": {"type": "boolean"},
    "status": {"enum": ["PASSED", "FAILED", "TOOL_NOT_FOUND", "TIMEOUT"]},
    "argv": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "exit_code": {"type": ["integer", "null"]},
    "timed_out": {"type": "boolean"},
    "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stdout_size_bytes": {"type": "integer", "minimum": 0},
    "stderr_size_bytes": {"type": "integer", "minimum": 0}
  }
}
