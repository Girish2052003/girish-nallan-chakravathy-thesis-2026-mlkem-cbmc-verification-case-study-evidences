{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "counts": {
      "type": "object"
    },
    "evidence_by_role": {
      "type": "array"
    },
    "final_status_supplied_by_codex": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "const": "CODEX_SUPPLIED_UNVERIFIED"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "value",
        "notes",
        "authority"
      ],
      "type": "object"
    },
    "gate_authority": {
      "const": "NONE"
    },
    "generated_at_utc": {
      "type": "string"
    },
    "mandatory_limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "manifest_status": {
      "enum": [
        "COMPLETE",
        "COMPLETE_WITH_WARNINGS",
        "INCOMPLETE"
      ]
    },
    "property_records": {
      "type": "array"
    },
    "run_id": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "semantic_authority": {
      "const": "NONE"
    },
    "skill": {
      "const": "verification-evidence-manifest"
    },
    "skill_version": {
      "type": "string"
    },
    "source_revision": {
      "type": "object"
    },
    "supporting_files": {
      "type": "object"
    },
    "target": {
      "type": "object"
    },
    "warnings": {
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "skill",
    "skill_version",
    "run_id",
    "generated_at_utc",
    "manifest_status",
    "semantic_authority",
    "gate_authority",
    "target",
    "source_revision",
    "property_records",
    "final_status_supplied_by_codex",
    "counts",
    "evidence_by_role",
    "supporting_files",
    "warnings",
    "mandatory_limitations"
  ],
  "title": "Verification Evidence Manifest",
  "type": "object"
}
