{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "items": {
    "additionalProperties": false,
    "properties": {
      "actual_sha256": {
        "pattern": "^[0-9a-f]{64}$",
        "type": [
          "string",
          "null"
        ]
      },
      "description": {
        "type": "string"
      },
      "exists": {
        "type": "boolean"
      },
      "expected_sha256": {
        "pattern": "^[0-9a-f]{64}$",
        "type": [
          "string",
          "null"
        ]
      },
      "hash_match": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "is_regular_file": {
        "type": "boolean"
      },
      "iteration": {
        "minimum": 0,
        "type": "integer"
      },
      "media_type": {
        "type": [
          "string",
          "null"
        ]
      },
      "path": {
        "type": "string"
      },
      "required": {
        "type": "boolean"
      },
      "role": {
        "enum": [
          "SOURCE_REVISION_EVIDENCE",
          "SPECIFICATION_EVIDENCE",
          "BUILD_CONTEXT_EVIDENCE",
          "HARNESS",
          "CBMC_COMMAND",
          "CBMC_RAW_STDOUT",
          "CBMC_RAW_STDERR",
          "CBMC_EXECUTION_SUMMARY",
          "COUNTEREXAMPLE_VIEW",
          "INTEGRITY_AUDIT",
          "NONVACUITY_REPORT",
          "CODEX_EVENT_LOG",
          "SKILL_OUTPUT",
          "ENVIRONMENT_SNAPSHOT",
          "REPAIR_LOG",
          "FINAL_STATUS_RECORD",
          "PROPERTY_RECORD",
          "OTHER"
        ]
      },
      "size_bytes": {
        "minimum": 0,
        "type": [
          "integer",
          "null"
        ]
      },
      "skill_name": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "path",
      "role",
      "required",
      "expected_sha256",
      "actual_sha256",
      "hash_match",
      "exists",
      "is_regular_file",
      "size_bytes",
      "media_type",
      "skill_name",
      "iteration",
      "description"
    ],
    "type": "object"
  },
  "title": "Input File Manifest",
  "type": "array"
}
