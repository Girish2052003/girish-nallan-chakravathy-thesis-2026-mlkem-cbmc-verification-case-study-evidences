{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "baseline_cbmc_outcome": {
      "type": "string"
    },
    "baseline_syntax_status": {
      "type": "string"
    },
    "caller_supplied_expected_effect": {
      "type": "string"
    },
    "caller_supplied_rationale": {
      "type": "string"
    },
    "declared_transition_match": {
      "enum": [
        "NOT_DECLARED",
        "INDETERMINATE",
        "MATCHES_CALLER_DECLARATION",
        "DIFFERS_FROM_CALLER_DECLARATION"
      ]
    },
    "declared_transition_observation": {
      "type": [
        "object",
        "null"
      ]
    },
    "execution_completeness_status": {
      "enum": [
        "COMPLETE",
        "COMPLETE_WITH_WARNINGS",
        "INCOMPLETE"
      ]
    },
    "interpretation_boundary": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "mutant_cbmc_outcome": {
      "type": "string"
    },
    "mutant_syntax_status": {
      "type": "string"
    },
    "mutation_id": {
      "type": "string"
    },
    "property_status_changes": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "request_id": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "semantic_authority": {
      "const": "NONE"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "mutation_id",
    "caller_supplied_rationale",
    "caller_supplied_expected_effect",
    "baseline_cbmc_outcome",
    "mutant_cbmc_outcome",
    "baseline_syntax_status",
    "mutant_syntax_status",
    "property_status_changes",
    "declared_transition_observation",
    "declared_transition_match",
    "warnings",
    "semantic_authority",
    "interpretation_boundary",
    "execution_completeness_status"
  ],
  "type": "object"
}
