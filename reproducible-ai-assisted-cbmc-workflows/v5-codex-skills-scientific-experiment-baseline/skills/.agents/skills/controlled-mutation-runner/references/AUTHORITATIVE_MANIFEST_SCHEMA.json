{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "actual_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "expected_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "hash_match": {
            "type": "boolean"
          },
          "mutation_allowed": {
            "type": "boolean"
          },
          "path": {
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "size_bytes": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "path",
          "role",
          "mutation_allowed",
          "expected_sha256",
          "actual_sha256",
          "hash_match",
          "size_bytes"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "phase": {
      "enum": [
        "BEFORE",
        "AFTER"
      ]
    },
    "schema_version": {
      "const": "1.0"
    }
  },
  "required": [
    "schema_version",
    "phase",
    "files"
  ],
  "type": "object"
}
