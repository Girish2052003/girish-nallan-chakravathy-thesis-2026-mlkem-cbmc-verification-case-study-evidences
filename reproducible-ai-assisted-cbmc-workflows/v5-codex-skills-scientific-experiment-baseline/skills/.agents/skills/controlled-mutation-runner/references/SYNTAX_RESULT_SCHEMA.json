{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "label": {
      "enum": [
        "baseline",
        "mutant"
      ]
    },
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "NOT_REQUESTED",
        "PASSED",
        "FAILED",
        "TIMEOUT"
      ]
    },
    "timed_out": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "label",
    "status",
    "exit_code",
    "timed_out"
  ],
  "type": "object"
}
