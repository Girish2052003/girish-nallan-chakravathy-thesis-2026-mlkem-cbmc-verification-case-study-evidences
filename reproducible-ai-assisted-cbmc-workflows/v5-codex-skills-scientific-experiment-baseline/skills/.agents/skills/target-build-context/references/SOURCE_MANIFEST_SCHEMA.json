{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Target Build Context Source Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "repository_identity", "scope", "files", "skipped_paths"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "request_id": {"type": "string", "minLength": 1},
    "repository_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_label", "root_path_recorded", "note"],
      "properties": {
        "root_label": {"type": "string"},
        "root_path_recorded": {"const": false},
        "note": {"type": "string"}
      }
    },
    "scope": {"type": "object"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes", "decode_status", "extension"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "decode_status": {"enum": ["utf8", "utf8_with_replacement"]},
          "extension": {"enum": [".c", ".h", ".inc", ".i"]}
        }
      }
    },
    "skipped_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {"path": {"type": "string"}, "reason": {"type": "string"}}
      }
    }
  }
}
