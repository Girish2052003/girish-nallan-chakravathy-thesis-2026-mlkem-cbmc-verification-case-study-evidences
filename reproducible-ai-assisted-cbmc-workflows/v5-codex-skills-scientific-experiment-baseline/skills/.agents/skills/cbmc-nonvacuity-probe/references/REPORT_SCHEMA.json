{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CBMC Non-Vacuity Probe Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill_version", "report_status", "target_symbol", "probe_count", "probe_results", "authoritative_inputs_unchanged", "semantic_authority", "gate_authority", "mandatory_limitations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "skill_version": {"const": "1.0.0-rc1"},
    "report_status": {"enum": ["COMPLETE", "INCOMPLETE", "SOURCE_MUTATION_DETECTED"]},
    "target_symbol": {"type": "string"},
    "probe_count": {"type": "integer", "minimum": 0},
    "probe_results": {"type": "array"},
    "authoritative_inputs_unchanged": {"type": "boolean"},
    "semantic_authority": {"const": "NONE"},
    "gate_authority": {"const": "NONE"},
    "mandatory_limitations": {"type": "array", "minItems": 5, "items": {"type": "string"}}
  }
}
