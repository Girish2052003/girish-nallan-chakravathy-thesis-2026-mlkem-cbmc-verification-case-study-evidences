{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Disposable Companion Manifest",
  "type": "object",
  "required": ["schema_version", "skill_version", "disposable", "authoritative_tree_modified", "insertion", "files"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "skill_version": {"const": "1.0.0-rc1"},
    "disposable": {"const": true},
    "authoritative_tree_modified": {"const": false},
    "insertion": {"type": "object"},
    "files": {"type": "array"}
  }
}
