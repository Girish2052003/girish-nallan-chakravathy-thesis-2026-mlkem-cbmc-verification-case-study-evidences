{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "File Manifest",
  "type": "object",
  "required": ["schema_version", "skill_version", "files"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "skill_version": {"const": "1.0.0-rc1"},
