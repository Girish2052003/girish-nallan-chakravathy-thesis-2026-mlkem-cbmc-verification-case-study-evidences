{
  "$id": "TARGET_BINDING_SCHEMA.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "analysis_nature": {
      "const": "LEXICAL_AND_MANIFEST_STRUCTURAL_ONLY"
    },
    "authoritative_definition_path": {
      "minLength": 1,
      "type": "string"
    },
    "harness_call_line_numbers": {
      "items": {
        "minimum": 1,
        "type": "integer"
      },
      "type": "array"
    },
    "harness_lexical_call_count": {
      "minimum": 0,
      "type": "integer"
    },
    "replacement_patterns": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "1.0"
    },
    "semantic_authority": {
      "const": "NONE"
    },
    "target_symbol": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "target_symbol",
    "authoritative_definition_path",
    "harness_lexical_call_count",
    "harness_call_line_numbers",
    "replacement_patterns",
    "analysis_nature",
    "semantic_authority"
  ],
  "type": "object"
}
